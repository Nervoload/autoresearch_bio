{
  "profile_id": "tinystories_8gb_soak",
  "dataset_id": "tinystories_gpt4_clean",
  "tokenizer_id": "tinystories_bpe4096",
  "mode": "soak",
  "time_budget_s": 7200,
  "max_seq_len": 256,
  "eval_tokens": 1048576,
  "dataset": {
    "kind": "hf_parquet",
    "hf_dataset": "karpathy/tinystories-gpt4-clean",
    "hf_split": "train",
    "text_column": "text",
    "train_range": [
      10000,
      null
    ],
    "val_range": [
      0,
      10000
    ]
  },
  "tokenizer": {
    "kind": "rustbpe",
    "vocab_size": 4096,
    "train_max_chars": 200000000,
    "doc_cap": 4096,
    "bos_token": "<|reserved_0|>",
    "special_tokens": [
      "<|reserved_0|>",
      "<|reserved_1|>",
      "<|reserved_2|>",
      "<|reserved_3|>"
    ],
    "split_pattern": "'(?i:[sdmt]|ll|ve|re)|[^\\r\\n\\p{L}\\p{N}]?+\\p{L}+|\\p{N}{1,2}| ?[^\\s\\p{L}\\p{N}]++[\\r\\n]*|\\s*[\\r\\n]|\\s+(?!\\S)|\\s+"
  },
  "model": {
    "legacy_scaling": false,
    "n_layer": 4,
    "n_embd": 256,
    "n_head": 4,
    "n_kv_head": 4,
    "window_pattern": "L"
  },
  "optim": {
    "total_batch_size": 16384,
    "device_batch_size": 8,
    "embedding_lr": 0.25,
    "unembedding_lr": 0.004,
    "matrix_lr": 0.02,
    "scalar_lr": 0.2,
    "weight_decay": 0.05,
    "adam_betas": [
      0.9,
      0.95
    ],
    "warmup_ratio": 0.02,
    "warmdown_ratio": 0.25,
    "final_lr_frac": 0.2
  },
  "checkpoint": {
    "interval_s": 900,
    "keep_last": 3
  },
  "mps": {
    "memory_fraction": 0.7,
    "warn_ratio": 0.85,
    "abort_ratio": 0.95,
    "abort_samples": 3
  },
  "sample": {
    "prompts": [
      "Once upon a time",
      "The little dragon",
      "Mia opened the door and"
    ],
    "max_new_tokens": 96,
    "temperature": 0.8,
    "top_k": 40
  }
}
