{
  "profile_id": "climbmix_legacy",
  "dataset_id": "climbmix_400b_shuffle",
  "tokenizer_id": "climbmix_bpe8192",
  "mode": "search",
  "time_budget_s": 300,
  "max_seq_len": 2048,
  "eval_tokens": 20971520,
  "dataset": {
    "kind": "climbmix_shards",
    "base_url": "https://huggingface.co/datasets/karpathy/climbmix-400b-shuffle/resolve/main",
    "default_num_shards": 10,
    "max_train_shard": 6542,
    "val_shard": 6542,
    "text_column": "text"
  },
  "tokenizer": {
    "kind": "rustbpe",
    "vocab_size": 8192,
    "train_max_chars": 1000000000,
    "doc_cap": 10000,
    "bos_token": "<|reserved_0|>",
    "special_tokens": [
      "<|reserved_0|>",
      "<|reserved_1|>",
      "<|reserved_2|>",
      "<|reserved_3|>"
    ],
    "split_pattern": "'(?i:[sdmt]|ll|ve|re)|[^\\r\\n\\p{L}\\p{N}]?+\\p{L}+|\\p{N}{1,2}| ?[^\\s\\p{L}\\p{N}]++[\\r\\n]*|\\s*[\\r\\n]|\\s+(?!\\S)|\\s+"
  },
  "model": {
    "legacy_scaling": true,
    "depth": 4,
    "aspect_ratio": 64,
    "head_dim": 128,
    "window_pattern": "L"
  },
  "optim": {
    "total_batch_size": 65536,
    "device_batch_size": 16,
    "embedding_lr": 0.6,
    "unembedding_lr": 0.004,
    "matrix_lr": 0.04,
    "scalar_lr": 0.5,
    "weight_decay": 0.2,
    "adam_betas": [
      0.8,
      0.95
    ],
    "warmup_ratio": 0.0,
    "warmdown_ratio": 0.5,
    "final_lr_frac": 0.0
  },
  "checkpoint": {
    "interval_s": 900,
    "keep_last": 2
  },
  "mps": {
    "memory_fraction": 0.7,
    "warn_ratio": 0.85,
    "abort_ratio": 0.95,
    "abort_samples": 3
  },
  "sample": {
    "prompts": [
      "Once upon a time",
      "In a distant galaxy",
      "The scientist looked at the data and"
    ],
    "max_new_tokens": 96,
    "temperature": 0.8,
    "top_k": 50
  }
}
